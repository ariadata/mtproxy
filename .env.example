COMPOSE_PROJECT_NAME="mtproxy"

INTERNAL_PORT=443
EXTERNAL_PORT=443
EXTERNAL_HOST=""

ENABLE_TLS=true
TLS_DOMAIN="www.cloudflare.com"

WORKERS=2
MAX_SPECIAL_CONNECTIONS=60000

# Optional: 32-char hex secret(s), comma-separated for multiple. Auto-generated if empty.
SECRET=""
# Optional: 32-char hex tag for promotion in Telegram
TAG=""
